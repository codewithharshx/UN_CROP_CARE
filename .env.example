# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# For production (e.g. Neon, AWS RDS, Railway, Render): append ?sslmode=require
DATABASE_URL=postgresql://uncropcare_app:your_secure_password@127.0.0.1:5432/uncropcare

# Better Auth Configuration
# Secret key: generate a random 32-byte hex or base64 string
BETTER_AUTH_SECRET=generate_a_random_32_byte_hex_or_base64_secret_key
# Base URL for authentication callbacks (e.g. https://un-crop-care.vercel.app)
BETTER_AUTH_URL=http://localhost:3000

# Server Port
PORT=3000

# Storage Driver
# Development: 'local' (writes to public/uploads)
# Production: 'vercel-blob' (requires BLOB_READ_WRITE_TOKEN from Vercel dashboard)
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
